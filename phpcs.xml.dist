<?xml version="1.0"?>
<ruleset name="VivaVoce">
	<description>Regole di scrittura del tema: WordPress Coding Standards e compatibilità con PHP 7.4.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="6.0"/>
	<config name="testVersion" value="7.4-"/>

	<!-- Convenzioni del tema: chiamate con un array o una funzione come ultimo argomento sulla stessa
	     riga (add_meta_box( 'id', array( … ) )) e array associativi brevi su una riga. -->
	<rule ref="WordPress-Extra">
		<exclude name="PEAR.Functions.FunctionCallSignature.MultipleArguments"/>
		<exclude name="PEAR.Functions.FunctionCallSignature.ContentAfterOpenBracket"/>
		<exclude name="PEAR.Functions.FunctionCallSignature.CloseBracketLine"/>
		<exclude name="WordPress.Arrays.ArrayDeclarationSpacing.AssociativeArrayFound"/>
		<exclude name="WordPress.Arrays.ArrayDeclarationSpacing.ArrayItemNoNewLine"/>
	</rule>
	<rule ref="PHPCompatibilityWP"/>

	<!-- post_full.php sostituisce il modello di Sydney con lo stesso nome: il nome non si cambia. -->
	<rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
		<exclude-pattern>/post-templates/post_full\.php</exclude-pattern>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="vivavoce"/>
			</property>
		</properties>
	</rule>
	<!-- Il prefisso del tema è vv_, che WPCS scarta perché più corto di tre caratteri: con la regola
	     accesa ogni funzione risulterebbe senza prefisso. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude name="WordPress.NamingConventions.PrefixAllGlobals"/>
	</rule>
</ruleset>
